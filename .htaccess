RewriteEngine On

# Eigene 404-Seite
ErrorDocument 404 /404.html

# 0. Kanonischer Host: alles außer mikaschieferdecker.de (z. B. www., neu.,
#    Vorschau-Hosts) per 301 auf die Hauptdomain (direkt via HTTPS).
RewriteCond %{HTTP_HOST} !^mikaschieferdecker\.de$ [NC]
RewriteRule ^(.*)$ https://mikaschieferdecker.de/$1 [L,R=301]

# 1. Erzwingt HTTPS (für die Hauptdomain selbst)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 1b. 301-Weiterleitung: /ratgeber → /blog (umbenannt)
RewriteRule ^ratgeber(?:\.html)?/?$ /blog [R=301,L]
RewriteRule ^ratgeber/(.+?)(?:\.html)?/?$ /blog/$1 [R=301,L]

# 1c. 301-Weiterleitungen: alte Leistungs-URLs → neue Disziplin-Seiten
RewriteRule ^leistungen/websites(?:\.html)?/?$ /leistungen/webdesign [R=301,L]
RewriteRule ^leistungen/unternehmenswebsites(?:\.html)?/?$ /leistungen/webdesign [R=301,L]
RewriteRule ^leistungen/shopify(?:\.html)?/?$ /leistungen/onlineshops [R=301,L]
RewriteRule ^leistungen/seo-betreuung(?:\.html)?/?$ /leistungen/seo [R=301,L]

# 2. Entfernt index.html aus der URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 3. WICHTIG: Wenn eine passende HTML-Datei existiert, nimm diese (löst den Projekte-Ordner-Konflikt)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ /$1.html [L]

# 4. Erlaubt allgemein den Aufruf von Seiten ohne .html Endung
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. Weiterleitung von seite.html auf /seite (Clean URLs)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/ [NC]
RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]
