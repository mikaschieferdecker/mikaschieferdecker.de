RewriteEngine On

# Eigene 404-Seite
ErrorDocument 404 /404.html

# 0. Kanonischer Host: alles außer mikaschieferdecker.de (z. B. www., neu.,
#    Vorschau-Hosts) per 301 auf die Hauptdomain (direkt via HTTPS).
RewriteCond %{HTTP_HOST} !^mikaschieferdecker\.de$ [NC]
RewriteRule ^(.*)$ https://mikaschieferdecker.de/$1 [L,R=301]

# 1. Erzwingt HTTPS (für die Hauptdomain selbst)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 1b. Onepager-Konsolidierung (301): alte Mehrseiten-URLs → Startseite / Anker.
#     Alle Redirects zeigen direkt auf das finale Ziel (keine 301-Ketten), damit
#     die SEO-Linkkraft erhalten bleibt. Das Flag NE erhält das '#' im
#     Location-Header, sodass der Anker-Sprung greift (Apache würde es sonst zu
#     %23 kodieren). Leistungs-/Blog-URLs → '/' (Anker serverseitig nicht sinnvoll).

# Projekte: Übersicht + Detailseiten (climaqx, pinkchilli, indira-indorf) → Projekte-Sektion
RewriteRule ^projekte(/.*)?$ /#projekte [R=301,L,NE]

# Über / Kontakt → jeweilige Sektion
RewriteRule ^ueber(?:\.html)?/?$ /#ueber [R=301,L,NE]
RewriteRule ^kontakt(?:\.html)?/?$ /#kontakt [R=301,L,NE]
RewriteRule ^projekt-anfrage(?:\.html)?/?$ /#kontakt [R=301,L,NE]

# Leistungen (alle 16 alten Unterseiten inkl. alter Slug-Varianten) → Startseite
RewriteRule ^leistungen(/.*)?$ / [R=301,L]

# Blog / Ratgeber (Übersicht + alle Artikel) → Startseite
RewriteRule ^blog(/.*)?$ / [R=301,L]
RewriteRule ^ratgeber(/.*)?$ / [R=301,L]

# Alte Aktions-URLs → Startseite
RewriteRule ^shop-check(?:\.html)?/?$ / [R=301,L]
RewriteRule ^shop-analyse(?:\.html)?/?$ / [R=301,L]

# 2. Entfernt index.html aus der URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 3. WICHTIG: Wenn eine passende HTML-Datei existiert, nimm diese (löst den Projekte-Ordner-Konflikt)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ /$1.html [L]

# 4. Erlaubt allgemein den Aufruf von Seiten ohne .html Endung
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. Weiterleitung von seite.html auf /seite (Clean URLs)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/ [NC]
RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]
